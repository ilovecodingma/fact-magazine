{
  "name": "comments",
  "title": "댓글·좋아요 키트",
  "parts": [
    "backend",
    "comments"
  ],
  "gives": "글 쪽 아래 댓글 칸과 「도움이 됐어요」 단추. 댓글은 기본 「승인 뒤 공개」, 좋아요는 한 사람이 하루 한 번.",
  "see": "글 쪽 맨 아래, 운영자 화면에서 승인",
  "mounts": "글 쪽 아래",
  "server": "필요",
  "minutes": "10",
  "input_line": "comments 키트를 켜고 글 쪽에 댓글을 달아 운영자 화면에서 승인하면 글 쪽에 보이는지 확인해 줘.",
  "selftest": {
    "server": true,
    "parts": [
      "backend",
      "comments",
      "info"
    ],
    "steps": [
      {
        "say": "글 쪽을 엽니다(아래에 댓글 칸이 있습니다)",
        "goto": "n/2026-11-11-apt/",
        "wait": 1.2,
        "expect": {
          "sel": "[data-widget=comments] h2",
          "contains": "댓글"
        }
      },
      {
        "say": "이름과 댓글 내용을 넣습니다",
        "type": [
          "[data-widget=comments] textarea[name=body]",
          "확인 노트 잘 봤습니다"
        ]
      },
      {
        "say": "「댓글 남기기」를 누르면 승인 안내가 나옵니다",
        "click": "[data-widget=comments] form button[type=submit]",
        "wait": 1.0,
        "expect": {
          "sel": "[data-widget=comments] .be-msg",
          "contains": "승인"
        }
      },
      {
        "say": "운영자가 로그인해 방금 댓글을 승인합니다",
        "wait": 0.4,
        "eval": "fetch('/api/admin/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:'test-pass-1234'})}).then(function(r){return r.json()}).then(function(){return fetch('/api/admin/summary').then(function(r){return r.json()})}).then(function(s){return fetch('/api/admin/comment',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:s.comments[0]._id,action:'approve'})}).then(function(r){return r.json()})}).then(function(j){return j.ok})",
        "equals": true
      },
      {
        "say": "글 쪽을 다시 열면 승인된 댓글이 보입니다",
        "goto": "n/2026-11-11-apt/",
        "wait": 1.4,
        "expect": {
          "sel": "[data-widget=comments] .cm-list",
          "contains": "잘 봤습니다"
        }
      },
      {
        "say": "좋아요 단추를 누르면 1 이 됩니다",
        "click": "button.be-like",
        "wait": 0.8,
        "expect": {
          "sel": "button.be-like b",
          "contains": "1"
        }
      }
    ]
  },
  "must_know": [
    {
      "알것": "댓글은 받자마자 보이지 않고 운영자가 승인해야 보인다",
      "까닭": "남의 글(스팸·욕설)을 내 사이트에 그대로 싣지 않으려고",
      "모르면": "스팸이 그대로 공개된다",
      "근거": "server/app.py /api/comments"
    },
    {
      "알것": "댓글 한 건은 JSON 문서 한 건이다(slug·name·body·status)",
      "까닭": "문서 형식이라 칸이 늘어도 표를 고치지 않는다",
      "모르면": "댓글에 칸을 더하려면 db 구조를 바꿔야 한다고 생각한다",
      "근거": "운영자 화면의 「댓글 문서 보기」"
    },
    {
      "알것": "지우지 않고 숨김 처리한다",
      "까닭": "잘못 숨겨도 되살릴 수 있다",
      "모르면": "실수로 지운 댓글을 못 찾는다",
      "근거": "/api/admin/comment"
    }
  ],
  "try_change": "댓글을 하나 달고 운영자 화면(/admin/)에서 「숨김」을 눌러 글 쪽에서 사라지는지 보세요."
}