{
  "name": "admin",
  "title": "운영자 화면 키트",
  "parts": [
    "backend"
  ],
  "gives": "/admin/ — 오늘 방문·인기 쪽·새 댓글·문의·소식 받기 수·하루 한 바퀴 기록·올릴 묶음을 한 화면에(휴대폰 폭도 됨). 로컬 암호(해시만 저장).",
  "see": "/admin/ 에서 암호를 넣으면 숫자 상자가 보입니다",
  "mounts": "/admin/(검색에 안 나감)",
  "server": "필요",
  "minutes": "5",
  "input_line": "운영자 화면을 열어 로그인하고 숫자 상자와 새 댓글 목록이 보이는지 확인해 줘.",
  "selftest": {
    "server": true,
    "parts": [
      "backend"
    ],
    "steps": [
      {
        "say": "운영자 화면을 엽니다(암호를 묻습니다)",
        "goto": "admin/",
        "wait": 1.0,
        "expect": {
          "sel": "#app",
          "contains": "암호"
        }
      },
      {
        "say": "틀린 암호를 넣으면 거절됩니다",
        "type": [
          "#pw",
          "wrong-pass"
        ]
      },
      {
        "say": "「들어가기」를 누릅니다",
        "click": "#go",
        "wait": 0.8,
        "expect": {
          "sel": "#app",
          "contains": "맞지 않습니다"
        }
      },
      {
        "say": "맞는 암호를 넣습니다",
        "type": [
          "#pw",
          "test-pass-1234"
        ]
      },
      {
        "say": "「들어가기」를 누르면 숫자 상자가 보입니다",
        "click": "#go",
        "wait": 1.2,
        "expect": {
          "sel": "#app",
          "contains": "오늘 방문"
        }
      }
    ]
  },
  "must_know": [
    {
      "알것": "운영자 암호는 서버 쪽에 해시로만 저장하고, 로그인하면 8시간짜리 쿠키를 준다",
      "까닭": "암호를 그대로 두면 파일이 유출될 때 끝이다",
      "모르면": "암호를 설정 파일에 그대로 적어 둔다",
      "근거": "server/app.py check_pw, run.py 서버 암호"
    },
    {
      "알것": "틀린 암호를 여러 번 넣으면 잠깐 막는다",
      "까닭": "무작위 대입을 늦춘다",
      "모르면": "암호 추측 공격에 무방비다",
      "근거": "server/app.py limited(login)"
    },
    {
      "알것": "바깥에 열 때는 이 화면 주소와 암호가 가장 중요한 방어선이다",
      "까닭": "이 화면은 댓글·문의·메일 주소를 다룬다",
      "모르면": "바깥에 열었다가 개인정보가 노출된다",
      "근거": "올리기.md"
    }
  ],
  "try_change": "python run.py 서버 암호 로 암호를 바꾸고 다시 로그인해 보세요."
}