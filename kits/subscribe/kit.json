{
  "name": "subscribe",
  "title": "소식 받기 키트",
  "parts": [
    "backend",
    "subscribe"
  ],
  "gives": "소식 받기 쪽(/subscribe/)의 신청 양식. 신청한 메일 주소는 서버 db 에만 쌓이고, 같은 주소는 한 건만 남는다.",
  "see": "/subscribe/, /admin/ 의 소식 받기 수",
  "mounts": "소식 받기 쪽",
  "server": "필요",
  "minutes": "5",
  "input_line": "소식 받기 양식을 켜고 같은 주소로 두 번 신청해 한 건만 남는지 확인해 줘.",
  "selftest": {
    "server": true,
    "parts": [
      "backend",
      "subscribe"
    ],
    "steps": [
      {
        "say": "소식 받기 쪽을 엽니다",
        "goto": "subscribe/",
        "wait": 1.2,
        "expect": {
          "sel": "[data-widget=subscribe] h2",
          "contains": "소식 받기"
        }
      },
      {
        "say": "메일 주소를 넣고 신청합니다",
        "type": [
          "[data-widget=subscribe] input[name=email]",
          "reader@example.com"
        ]
      },
      {
        "say": "「신청하기」를 누르면 접수 안내가 나옵니다",
        "click": "[data-widget=subscribe] form button[type=submit]",
        "wait": 1.0,
        "expect": {
          "sel": "[data-widget=subscribe] .be-msg",
          "contains": "신청했습니다"
        }
      },
      {
        "say": "같은 주소로 한 번 더 신청합니다",
        "type": [
          "[data-widget=subscribe] input[name=email]",
          "reader@example.com"
        ]
      },
      {
        "say": "두 번 신청해도 운영자 화면에는 한 건만 있습니다",
        "click": "[data-widget=subscribe] form button[type=submit]",
        "wait": 1.0
      },
      {
        "say": "소식 받기 신청 수가 1 입니다",
        "wait": 0.3,
        "eval": "fetch('/api/admin/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:'test-pass-1234'})}).then(function(r){return r.json()}).then(function(){return fetch('/api/admin/summary').then(function(r){return r.json()})}).then(function(s){return s.subscribers})",
        "equals": 1
      }
    ]
  },
  "must_know": [
    {
      "알것": "같은 메일 주소는 한 건만 남는다(중복 금지)",
      "까닭": "id 를 메일 주소로 정해 같은 자리에 덮어쓰기 때문",
      "모르면": "같은 사람에게 메일이 두 번 나간다",
      "근거": "server/app.py 의 subscribers 문서 id"
    },
    {
      "알것": "메일 주소는 소식 보내는 데만 쓴다",
      "까닭": "약속한 목적 밖으로 쓰지 않는다",
      "모르면": "개인정보를 함부로 다루게 된다",
      "근거": "/subscribe/ 안내 문장"
    },
    {
      "알것": "실제 메일을 보내는 일은 사람이 승인한다",
      "까닭": "발송은 되돌릴 수 없다",
      "모르면": "실수로 모두에게 잘못된 메일이 나간다",
      "근거": "mail.py 는 기본이 미리보기"
    }
  ],
  "try_change": "운영자 화면에서 소식 받기 수가 바뀌는지 보고, 같은 주소로 다시 신청해 수가 그대로인지 보세요."
}