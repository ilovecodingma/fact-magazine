[
  {
    "slug": "saving-goal",
    "title": "저축 목표 계산기",
    "desc": "목표 금액을 정한 기간 안에 모으려면 매달 얼마를 저축해야 하는지 계산합니다.",
    "inputs": [
      {
        "id": "goal",
        "label": "목표 금액",
        "unit": "원",
        "default": 12000000
      },
      {
        "id": "months",
        "label": "기간",
        "unit": "개월",
        "default": 24
      },
      {
        "id": "rate",
        "label": "연 이자율(세전)",
        "unit": "%",
        "default": 3
      }
    ],
    "vars": [
      {
        "id": "r",
        "expr": "rate/100/12"
      }
    ],
    "results": [
      {
        "label": "매달 저축할 금액",
        "format": "won",
        "expr": "r==0 ? goal/months : goal*r/(Math.pow(1+r,months)-1)"
      },
      {
        "label": "원금 합계",
        "format": "won",
        "expr": "(r==0 ? goal/months : goal*r/(Math.pow(1+r,months)-1))*months"
      },
      {
        "label": "이자로 채우는 금액(세전)",
        "format": "won",
        "expr": "goal-(r==0 ? goal : goal*r/(Math.pow(1+r,months)-1)*months)"
      }
    ],
    "note": "매달 말에 같은 금액을 넣고 월 복리로 계산한 참고용 결과입니다. 이자소득세·상품별 조건은 반영하지 않았습니다."
  },
  {
    "slug": "compound-interest",
    "title": "복리 계산기",
    "desc": "처음 넣은 돈이 해마다 같은 비율로 불어나면 몇 년 뒤 얼마가 되는지 계산합니다.",
    "inputs": [
      {
        "id": "p",
        "label": "처음 넣은 금액",
        "unit": "원",
        "default": 10000000
      },
      {
        "id": "years",
        "label": "기간",
        "unit": "년",
        "default": 10
      },
      {
        "id": "rate",
        "label": "연 수익률",
        "unit": "%",
        "default": 4
      }
    ],
    "vars": [],
    "results": [
      {
        "label": "기간이 끝났을 때 금액",
        "format": "won",
        "expr": "p*Math.pow(1+rate/100,years)"
      },
      {
        "label": "늘어난 금액",
        "format": "won",
        "expr": "p*Math.pow(1+rate/100,years)-p"
      }
    ],
    "note": "해마다 한 번 복리로 붙는다고 가정한 참고용 결과입니다. 세금·수수료·수익률 변동은 반영하지 않았습니다."
  }
]